    "admin_audit_read": {
      "arguments": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "after": {
            "description": "Records after this sequence number; 0 when left out.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "limit": {
            "description": "How many records at most: 1 to 10000, 1000 when left out.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_bytes": {
            "description": "The most bytes the result may hold; the server's ceiling applies.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "title": "AuditArgs",
        "type": "object"
      },
      "hints": {
        "destructive": false,
        "idempotent": false,
        "open_world": false,
        "read_only": true
      },
      "scope": "admin"
    },
    "admin_key_create": {
      "arguments": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "expires_in_days": {
            "default": null,
            "description": "The days until the key expires, from 1 to 365; 90 when absent.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "label": {
            "description": "Who holds the key.",
            "type": "string"
          },
          "no_expiry": {
            "default": null,
            "description": "True for a key that never expires, where the configuration allows\none.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "scopes": {
            "description": "The scopes it holds: write, read, delete, legal, audit, tenant_admin.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "tenant": {
            "description": "The tenant the key belongs to.",
            "type": "string"
          }
        },
        "required": [
          "tenant",
          "scopes",
          "label"
        ],
        "title": "KeyCreateArgs",
        "type": "object"
      },
      "hints": {
        "destructive": false,
        "idempotent": false,
        "open_world": false,
        "read_only": false
      },
      "scope": "admin"
    },
