#!/usr/bin/env bash
# Refuses a push unless every outgoing commit has a good signature from an
# allowed signer (git verify-commit), its author and committer both match
# the pusher's configured user.name and user.email, and its whole message
# passes scripts/scan-commit-messages.sh: a commit made with --no-verify or
# by another tool never ran the commit-msg hook. Each outgoing commit also
# keeps the released part of CHANGELOG.md of its parents.
set -euo pipefail
remote="$1"
root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
name="$(git config user.name)"
email="$(git config user.email)"
bad=0
# The files the outgoing commits change, over every ref pushed, and the
# pushed refs that send commits, one line each as git gave them.
changed=""
refs=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue              # deleting a ref: nothing outgoing
  if [ "$remote_sha" = "$zero" ]; then
    range=("$local_sha" --not "--remotes=$remote")    # new ref: commits the remote lacks
  else
    range=("$remote_sha..$local_sha")
  fi
  # Captured first, so a failing rev-list stops the push instead of
  # silently yielding no commits to check.
  if ! commits="$(git rev-list "${range[@]}" 2>/dev/null)"; then
    echo "pre-push: refused: cannot list the commits going to $remote_ref; fetch first" >&2
    exit 1
  fi
  while read -r sha; do
    [ -n "$sha" ] || continue
    if ! git verify-commit "$sha" >/dev/null 2>&1; then
      echo "pre-push: refused: $sha has no good signature from an allowed signer" >&2
      bad=1
    fi
    IFS=$'\t' read -r an ae cn ce < <(git log -1 --format=$'%an\t%ae\t%cn\t%ce' "$sha")
    if [ "$an" != "$name" ] || [ "$ae" != "$email" ]; then
      echo "pre-push: refused: $sha author is not the configured identity" >&2
      bad=1
    fi
    if [ "$cn" != "$name" ] || [ "$ce" != "$email" ]; then
      echo "pre-push: refused: $sha committer is not the configured identity" >&2
      bad=1
    fi
    if ! "$root/scripts/scan-commit-messages.sh" "$sha"; then
      echo "pre-push: refused: $sha has a message the commit rules refuse" >&2
      bad=1
    fi
  done <<< "$commits"
  # Each outgoing commit keeps the released part of CHANGELOG.md of its
  # parents (scripts/check_changelog_released.py): a rebase runs no commit
  # hook, and on 2026-11-26 one put an [Unreleased] entry under the
  # released 0.4.18 heading with no conflict.
  if [ -n "$commits" ]; then
    mapfile -t listed <<< "$commits"
    if ! python3 -I "$root/scripts/check_changelog_released.py" commits "${listed[@]}" >/dev/null; then
      echo "pre-push: refused: a commit going to $remote_ref changes a released section of CHANGELOG.md" >&2
      bad=1
    fi
  fi
  changed+="$(git log --name-only --format= "${range[@]}")"$'\n'
  [ -n "$commits" ] && refs+="$local_ref $local_sha $remote_ref $remote_sha"$'\n'
done

# CI's "git hooks" job runs two hook tests that no commit hook runs; a push
# that changes a file they read runs them here (scripts/hook_tests.py holds
# the rule). Skipped when a commit is already refused.
if [ "$bad" -eq 0 ]; then
  set +e
  printf '%s' "$changed" | python3 -I "$root/scripts/hook_tests.py" needed
  verdict=$?
  set -e
  case "$verdict" in
    0)
      if ! "$root/scripts/test-hooks.sh" </dev/null || ! "$root/scripts/test-pre-push.sh" </dev/null; then
        echo "pre-push: refused: the hook tests failed (scripts/test-hooks.sh, scripts/test-pre-push.sh)" >&2
        bad=1
      fi
      ;;
    1) ;;
    *)
      echo "pre-push: refused: cannot tell whether the hook tests are needed (scripts/hook_tests.py)" >&2
      bad=1
      ;;
  esac
fi

# CI's how-to jobs run the pages' commands against a live server; a push
# that changes a page a scenario runs, a file the server is built from, or
# the runner needs those scenarios to have passed on each pushed ref's tip
# (scripts/docs_test.py holds the rule and names each scenario it skips).
# They run before the push (`docs_test.py push <sha> --since origin/main`),
# which stamps the commit: git push holds its connection to GitHub open
# while this hook runs, and GitHub closed it during a 25-minute run on
# 2026-11-15. Here only stamps are read, for the tip and for the range's
# commits, and CI's how-to jobs on the tip itself (`docs_test.py check`
# reads each ref's range, the stamps and CI). Skipped when a commit is
# already refused.
if [ "$bad" -eq 0 ] && [ -n "$refs" ]; then
  if ! printf '%s' "$refs" | python3 -I "$root/scripts/docs_test.py" check --remote "$remote"; then
    echo "pre-push: refused: the how-to scenarios this push needs have not passed on its commit (scripts/docs_test.py check)" >&2
    bad=1
  fi
fi

exit "$bad"
