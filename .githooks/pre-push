#!/usr/bin/env bash
# Refuses a push unless every outgoing commit has a good signature from an
# allowed signer (git verify-commit) and its author and committer both match
# the pusher's configured user.name and user.email.
set -euo pipefail
remote="$1"
zero="0000000000000000000000000000000000000000"
name="$(git config user.name)"
email="$(git config user.email)"
bad=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue              # deleting a ref: nothing outgoing
  if [ "$remote_sha" = "$zero" ]; then
    range=("$local_sha" --not "--remotes=$remote")    # new ref: commits the remote lacks
  else
    range=("$remote_sha..$local_sha")
  fi
  # Captured first, so a failing rev-list stops the push instead of
  # silently yielding no commits to check.
  if ! commits="$(git rev-list "${range[@]}" 2>/dev/null)"; then
    echo "pre-push: refused: cannot list the commits going to $remote_ref; fetch first" >&2
    exit 1
  fi
  while read -r sha; do
    [ -n "$sha" ] || continue
    if ! git verify-commit "$sha" >/dev/null 2>&1; then
      echo "pre-push: refused: $sha has no good signature from an allowed signer" >&2
      bad=1
    fi
    IFS=$'\t' read -r an ae cn ce < <(git log -1 --format=$'%an\t%ae\t%cn\t%ce' "$sha")
    if [ "$an" != "$name" ] || [ "$ae" != "$email" ]; then
      echo "pre-push: refused: $sha author is not the configured identity" >&2
      bad=1
    fi
    if [ "$cn" != "$name" ] || [ "$ce" != "$email" ]; then
      echo "pre-push: refused: $sha committer is not the configured identity" >&2
      bad=1
    fi
  done <<< "$commits"
done

exit "$bad"
