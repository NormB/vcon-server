#!/usr/bin/env bash
# Refuses a commit whose staged changes name an AI tool, hold personal data,
# carry private design-document ids or exports, or fail fmt, the style check,
# clippy or tests.
# The cargo checks run on a copy of exactly what is staged.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"

# Staged paths and added lines, as "<path>\t<text>".
scan_input() {
  git diff --cached --name-only -z --diff-filter=ACMR | while IFS= read -r -d '' p; do
    printf '%s\t%s\n' "$p" "$p"
  done
  git diff --cached --no-color --no-ext-diff -U0 --diff-filter=ACMR | awk '
    /^\+\+\+ b\// { path = substr($0, 7); next }
    /^\+\+\+ / { path = ""; next }
    /^\+/ && path != "" { printf "%s\t%s\n", path, substr($0, 2) }'
}
if ! scan_input | python3 -I scripts/scan_forbidden.py; then
  echo "pre-commit: refused (see the findings above)" >&2
  exit 1
fi

# No export of the private design documents, even if added with --force.
while IFS= read -r -d '' p; do
  case "$(basename -- "$p")" in
    "vcon-server — "* | "ARCHIVED — "*)
      echo "pre-commit: refused: private document export staged: $p" >&2
      exit 1 ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

scripts/check-ignored-exports.sh >/dev/null

# fmt, clippy and tests on exactly what is staged.
staged="$(mktemp -d)"
trap 'rm -rf "$staged"' EXIT
git checkout-index -a -f --prefix="$staged/"
cd "$staged"
# Every path .bestpractices.json links to on main still exists.
python3 -I scripts/test_check_repo_links.py
python3 -I scripts/test_published_metrics.py
scripts/test-scan-commit-messages.sh
python3 -I scripts/test_check_site_links.py
python3 -I scripts/test_check_dependabot.py
# Always a directory of its own: a test binary records the directory it was
# built from, so sharing the caller's target directory would leave binaries
# there that read files from this deleted copy.
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$root/target}/pre-commit"
# Formatting with rustfmt.toml on the pinned nightly rustfmt, the fuzz
# package included, then the style rules rustfmt and clippy do not check.
scripts/rustfmt.sh --check
python3 -I scripts/test_check_style.py
python3 -I scripts/check_style.py --walk
cargo clippy --workspace --all-targets --locked --quiet -- -D warnings
cargo test --workspace --locked --quiet
# The fuzz package is a workspace of its own, which --workspace does not
# reach; it is checked with the same toolchain.
if [ -f fuzz/Cargo.toml ]; then
  cargo clippy --manifest-path fuzz/Cargo.toml --all-targets --locked --quiet -- -D warnings
  cargo test --manifest-path fuzz/Cargo.toml --lib --locked --quiet
fi

# What each crate would publish: its files, manifest, README links, and the
# same scan as above over every packaged file.
python3 -I scripts/test_check_package.py
# The rule that holds release binaries to the glibc floor.
python3 -I scripts/test_check_glibc.py
python3 -I scripts/check_package.py
