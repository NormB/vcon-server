#!/usr/bin/env bash
# Refuses a commit message that names an AI tool, holds personal data or
# carries private design-document ids. Every line is scanned, those that
# start with # too: git commit -m and -F keep them (cleanup mode
# "whitespace"), so they can reach the stored message. A comment line of
# git's own template is scanned as well, which can only refuse more.
#
# Then warns, and never refuses, when the message has no DCO sign-off that
# CI's advisory `DCO` job (.github/workflows/dco.yml) would accept: a
# `Signed-off-by:` line naming the author's GitHub noreply address
# (scripts/check_dco.py, CONTRIBUTING.md "Signing off commits"). A
# maintainer whose commits the job exempts sets `git config dco.exempt
# true` in the clone, and the step prints nothing (MAINTAINERS.md).
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
if ! sed 's/^/<commit message>\t/' "$1" | python3 -I "$root/scripts/scan_forbidden.py"; then
  echo "commit-msg: refused (see the findings above)" >&2
  exit 1
fi
if [ "$(git config --type=bool --default=false dco.exempt)" != true ]; then
  python3 -I "$root/scripts/check_dco.py" --warn-local "$1" "$(git var GIT_AUTHOR_IDENT)" || true
fi
