#!/usr/bin/env bash
# Refuses a commit message that names an AI tool, holds personal data or
# carries private design-document ids. Every line is scanned, those that
# start with # too: git commit -m and -F keep them (cleanup mode
# "whitespace"), so they can reach the stored message. A comment line of
# git's own template is scanned as well, which can only refuse more.
#
# Then refuses a message without a DCO sign-off that CI's `DCO` job
# (.github/workflows/dco.yml), which the `main` ruleset requires, would
# accept: a `Signed-off-by:` line naming the author's GitHub noreply
# address (scripts/check_dco.py, CONTRIBUTING.md "Signing off commits").
# The job exempts the owner's verified commits, which a local hook cannot
# tell apart, so the owner sets `git config dco.exempt true` in the owner's
# clone and this step is skipped (MAINTAINERS.md).
#
# The scan also refuses an email address in a trailer (a line
# `git interpret-trailers --parse` reads as one), a reserved address
# included: an address belongs only in the author and committer fields
# (CONTRIBUTING.md, "Personal data in commit messages").
#
# A commit that moves the pin of the released part of CHANGELOG.md
# (.config/changelog-released.sha256), a deliberate edit of released text,
# names that file in its message (scripts/check_changelog_released.py).
#
# Every check runs, so one commit names every reason it is refused.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
refused=0
if ! python3 -I "$root/scripts/scan_forbidden.py" --commit-message "$1"; then
  echo "commit-msg: refused (see the findings above)" >&2
  refused=1
fi
python3 -I "$root/scripts/check_changelog_released.py" message "$1" || refused=1
if [ "$(git config --type=bool --default=false dco.exempt)" != true ]; then
  python3 -I "$root/scripts/check_dco.py" --local "$1" "$(git var GIT_AUTHOR_IDENT)" || refused=1
fi
exit "$refused"
