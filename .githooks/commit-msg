#!/usr/bin/env bash
# Refuses a commit message that names an AI tool, holds personal data or
# carries private design-document ids. Every line is scanned, those that
# start with # too: git commit -m and -F keep them (cleanup mode
# "whitespace"), so they can reach the stored message. A comment line of
# git's own template is scanned as well, which can only refuse more.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
if ! sed 's/^/<commit message>\t/' "$1" | python3 -I "$root/scripts/scan_forbidden.py"; then
  echo "commit-msg: refused (see the findings above)" >&2
  exit 1
fi
